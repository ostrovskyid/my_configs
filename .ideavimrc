" .ideavimrc is a configuration file for the IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" Command reference:        https://jb.gg/h38q75
" Share/examples:           https://jb.gg/share-ideavimrc
" Supported plugins (wiki): https://jb.gg/ideavim-plugins
" IdeaVim set-commands:     https://github.com/JetBrains/ideavim/blob/master/doc/set-commands.md
"
" Tip: run `:set trackactionids` (or `:actionlist <pattern>`) to discover the
"      <Action>(...) id behind any IDE command you want to map.


"" Base Settings
"" ========================================================

set scrolloff=10              " keep 10 lines of context above/below the cursor
set sidescrolloff=10          " ...and to the sides when nowrap is on
set number                    " absolute line numbers
set showmode                  " show -- INSERT -- etc. in the status line
set showcmd                   " show the partial command as you type it
set history=1000              " remember more : and / commands

" Searching
set ignorecase               " case-insensitive search...
set smartcase                " ...unless the pattern contains an uppercase char
set incsearch                " jump to matches while typing the pattern
set hlsearch                 " highlight all matches

set visualbell               " flash instead of beeping

" Clipboard: share the system clipboard, and let IDE paste actions stay in sync
set clipboard+=unnamed
set clipboard+=ideaput

let mapleader = " "


"" IDE Integration (IdeaVim-specific options)
"" ========================================================

set ideajoin                 " use the IDE's smart "join lines" when pressing J
set ideamarks                " sync Vim global marks with IDE bookmarks
set idearefactormode=keep    " stay in the current Vim mode during refactors
set ideastatusicon=gray      " low-key IdeaVim status-bar icon


"" Plugin Settings
"" ========================================================
"" See https://jb.gg/ideavim-plugins

set surround                 " ys / cs / ds to add, change, delete surroundings
set commentary               " gcc / gc{motion} to (un)comment
set ReplaceWithRegister       " gr{motion} / grr to replace text with a register
set exchange                 " cx{motion} then cx again to swap two regions
set multiple-cursors         " multi-cursor selection (mappings below)
set matchit                  " smarter % matching (HTML/XML tags, keywords)

" Text objects
set argtextobj              " ia / aa  -> function argument
set textobj-entire          " ie / ae  -> entire buffer
set textobj-indent          " ii / ai  -> indentation block
set vim-paragraph-motion    " make { and } also stop on whitespace-only lines
let g:argtextobj_pairs = "(:),[:],{:},<:>"

" Visual feedback on yank
set highlightedyank
let g:highlightedyank_highlight_duration = "300"

" Motion plugins
set sneak                    " s{char}{char} / S{char}{char} two-char motions
set easymotion               " <leader>j to jump anywhere on screen
set notimeout                " required by easymotion's multi-key mappings

" File tree
set nerdtree                 " :NERDTree* commands and <leader>x toggle


"" which-key
"" ========================================================
set which-key
let g:WhichKey_FontSize = 16
let g:WhichKey_CommandColor = "#41ead4"
let g:WhichKey_PrefixColor = "#f335b2"
let g:WhichKey_SortOrder = "by_key_prefix_first"

let g:WhichKeyDesc_leader = "<leader> Leader key"

let g:WhichKeyDesc_file_quickLook = "<leader><leader> Recent files"

