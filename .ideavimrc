" --- Android Studio ---
let g:WhichKeyDesc_run = "<leader>R Run / Debug"
let g:WhichKeyDesc_run_run = "<leader>Rr Run app"
let g:WhichKeyDesc_run_debug = "<leader>Rd Debug app"
let g:WhichKeyDesc_run_stop = "<leader>Rs Stop"
