let g:WhichKeyDesc_tool_debug = "<leader>od Debug"
let g:WhichKeyDesc_tool_terminal = "<leader>ot Terminal"
let g:WhichKeyDesc_tool_project = "<leader>op Project"
let g:WhichKeyDesc_tool_inspection = "<leader>oi App Inspection"


"" Key mappings
"" ========================================================

" Quick escape from insert mode
inoremap jk <Esc>

" Clear search highlight
nnoremap <leader>h :nohlsearch<CR>

" Keep the cursor centered when scrolling and searching
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap n nzzzv
nnoremap N Nzzzv

" Join lines without moving the cursor to the join point
nnoremap J mzJ`z

" Yank to end of line (consistent with C and D)
nnoremap Y y$

" Paste over a visual selection without clobbering the yank register
xnoremap <leader>p "_dP

" Tab navigation
nnoremap <A-n> :tabnext<CR>
nnoremap <A-p> :tabprev<CR>

" Pane navigation
nnoremap <A-h> <C-w>h
nnoremap <A-l> <C-w>l
nnoremap <A-k> <C-w>k
nnoremap <A-j> <C-w>j

" Jump between methods
nnoremap [[ <Action>(MethodUp)
nnoremap ]] <Action>(MethodDown)

" Navigate diagnostics quickly
nnoremap [e <Action>(GotoPreviousError)
nnoremap ]e <Action>(GotoNextError)

" Easy, repeatable visual indentation
vnoremap < <gv
vnoremap > >gv

" Move selected lines up/down, keeping them selected and re-indented
vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

" Execute the macro saved in the 'q' register
nnoremap qj @q

" Code-completion popup navigation
inoremap <C-j> <Action>(PopupMenu-selectNext)
inoremap <C-k> <Action>(PopupMenu-selectPrev)


"" multiple-cursors mappings
"" ========================================================
" Remapped off the plugin's default <A-n>/<A-p> so they don't collide with the
" <A-n>/<A-p> tab navigation above.
nmap <C-n> <Plug>NextWholeOccurrence
xmap <C-n> <Plug>NextWholeOccurrence
nmap g<C-n> <Plug>NextOccurrence
xmap g<C-n> <Plug>NextOccurrence
xmap <C-x> <Plug>SkipOccurrence
xmap <C-p> <Plug>RemoveOccurrence


"" Leader commands
"" ========================================================

" Comment lines (also available via gcc / gc{motion} from commentary)
map <leader>c <Action>(CommentByLineComment)

" Jump around with easymotion
map <leader>j <Plug>(easymotion-s)

" Toggle the NERDTree file explorer (use q inside the tree to close it)
map <leader>x :NERDTreeToggle<CR>

" Folding
map <leader>zc :action CollapseAllRegions<CR>
map <leader>zo :action ExpandAllRegions<CR>

" Window splits
map <leader>wv <Action>(SplitVertically)
map <leader>ws <Action>(SplitHorizontally)
map <leader>wu <Action>(Unsplit)
map <leader>wm <Action>(MoveEditorToOppositeTabGroup)

" Display options
map <leader>dd <Action>(ToggleDistractionFreeMode)
map <leader>dz <Action>(ToggleZenMode)
map <leader>df <Action>(ToggleFullScreen)

" Actions
map <leader>am <Action>(ShowIntentionActions)
map <leader>as <Action>(SearchEverywhere)

" File navigation
map <leader>ff <Action>(GotoFile)
map <leader>fr <Action>(RecentFiles)
map <leader>fc <Action>(FindInPath)
map <leader>fl <Action>(RecentLocations)
map <leader>fs <Action>(NewScratchFile)
map <leader><leader> <Action>(RecentFiles)

" Close active tab
map <leader>q <Action>(CloseContent)

" Refactoring
map <leader>rn <Action>(RenameElement)
map <leader>rm <Action>(ExtractMethod)
map <leader>rv <Action>(IntroduceVariable)
map <leader>rf <Action>(IntroduceField)
map <leader>rs <Action>(ChangeSignature)
map <leader>rr <Action>(Refactorings.QuickListPopupAction)

" Go to code
nmap <leader>gd <Action>(GotoDeclaration)
nmap <leader>gy <Action>(GotoTypeDeclaration)
nmap <leader>gi <Action>(GotoImplementation)
nmap <leader>gu <Action>(ShowUsages)
nmap <leader>gt <Action>(GotoTest)
nmap <leader>gb <Action>(Back)
nmap <leader>gf <Action>(Forward)

" Git (version control)
map <leader>Gc <Action>(CheckinProject)
map <leader>Gs <Action>(ActivateVersionControlToolWindow)
map <leader>Gb <Action>(Git.Branches)
map <leader>Gl <Action>(Vcs.Show.Log)
map <leader>Ga <Action>(Annotate)

" Errors
map <leader>en <Action>(GotoNextError)
map <leader>ep <Action>(GotoPreviousError)


"" Android Studio
"" ========================================================
" If any of these are no-ops, the action id changed in your AS version:
" run `:set trackactionids` then trigger the command to print its real id,
" or `:actionlist <pattern>` to search. Most ids below are mirrored from
" .atamanrc.config, which is known to work on this setup.

" Run / Debug
map <leader>Rr <Action>(Run)
map <leader>Rd <Action>(Debug)
map <leader>Rs <Action>(Stop)
map <leader>Rl <Action>(Rerun)
map <leader>Rc <Action>(Android.Deploy.ApplyChanges)
map <leader>RC <Action>(Android.Deploy.ApplyCodeChanges)
map <leader>Rn <Action>(ChooseRunConfiguration)
map <leader>Re <Action>(editRunConfigurations)

" Android
map <leader>As <Action>(Android.SyncProject)
map <leader>Ab <Action>(CompileDirty)
map <leader>Av <Action>(Android.RunAndroidAvdManager)
map <leader>Ad <Action>(DeviceAndSnapshotComboBox)
map <leader>Aa <Action>(AndroidConnectDebuggerAction)

" Tool windows
map <leader>ol <Action>(ActivateLogcatToolWindow)
map <leader>og <Action>(ActivateGradleToolWindow)
map <leader>ob <Action>(ActivateBuildToolWindow)
map <leader>or <Action>(ActivateRunToolWindow)
map <leader>od <Action>(ActivateDebugToolWindow)
map <leader>ot <Action>(ActivateTerminalToolWindow)
map <leader>op <Action>(ActivateProjectToolWindow)
map <leader>oi <Action>(ActivateAppInspectionToolWindow)
